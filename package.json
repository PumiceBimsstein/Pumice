  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "esbuild": "^0.27.4",
    "tailwindcss": "^4.3.3"
  }
